# Secrets: none are needed, but never commit them if added later
.env
.env.*
*.key

# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data is regenerated by the pipeline; the cache manifest is kept for provenance
data/raw/**/*.parquet
data/raw/**/*.tmp
data/curated/
data/*.duckdb
data/*.duckdb.wal
